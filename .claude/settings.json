{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": ["mcp__codex__codex", "mcp__codex__codex-reply", "mcp__pencil"],
    "deny": []
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "afplay ~/dotfiles/public/ask.wav"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/yutaaoki/.nvm/versions/node/v22.20.0/bin/node\" \"/Users/yutaaoki/.claude/agent-flow/hook.js\"",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay ~/dotfiles/public/stop.wav"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/yutaaoki/.nvm/versions/node/v22.20.0/bin/node\" \"/Users/yutaaoki/.claude/agent-flow/hook.js\"",
            "timeout": 2
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay ~/dotfiles/public/start.wav"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay ~/dotfiles/public/start.wav"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/yutaaoki/.nvm/versions/node/v22.20.0/bin/node\" \"/Users/yutaaoki/.claude/agent-flow/hook.js\"",
            "timeout": 2
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/dotfiles/hooks/dev-workflow-guard.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/yutaaoki/.nvm/versions/node/v22.20.0/bin/node\" \"/Users/yutaaoki/.claude/agent-flow/hook.js\"",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun x gh-setup-hooks",
            "timeout": 120
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/yutaaoki/.nvm/versions/node/v22.20.0/bin/node\" \"/Users/yutaaoki/.claude/agent-flow/hook.js\"",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/yutaaoki/.nvm/versions/node/v22.20.0/bin/node\" \"/Users/yutaaoki/.claude/agent-flow/hook.js\"",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/yutaaoki/.nvm/versions/node/v22.20.0/bin/node\" \"/Users/yutaaoki/.claude/agent-flow/hook.js\"",
            "timeout": 2
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/yutaaoki/.nvm/versions/node/v22.20.0/bin/node\" \"/Users/yutaaoki/.claude/agent-flow/hook.js\"",
            "timeout": 2
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/yutaaoki/.nvm/versions/node/v22.20.0/bin/node\" \"/Users/yutaaoki/.claude/agent-flow/hook.js\"",
            "timeout": 2
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "claude-mem@thedotmack": false,
    "figma@claude-plugins-official": false
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-daltonized"
}
