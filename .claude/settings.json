{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "mcp__codex__codex",
      "mcp__codex__codex-reply"
    ],
    "deny": []
  },
  "model": "fable[1m]",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/yutaaoki/.nvm/versions/node/v22.20.0/bin/node\" \"/Users/yutaaoki/.claude/agent-flow/hook.js\"",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/yutaaoki/.nvm/versions/node/v22.20.0/bin/node\" \"/Users/yutaaoki/.claude/agent-flow/hook.js\"",
            "timeout": 2
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/yutaaoki/.nvm/versions/node/v22.20.0/bin/node\" \"/Users/yutaaoki/.claude/agent-flow/hook.js\"",
            "timeout": 2
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/dotfiles/hooks/dev-workflow-guard.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/yutaaoki/.nvm/versions/node/v22.20.0/bin/node\" \"/Users/yutaaoki/.claude/agent-flow/hook.js\"",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun x gh-setup-hooks",
            "timeout": 120
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/yutaaoki/.nvm/versions/node/v22.20.0/bin/node\" \"/Users/yutaaoki/.claude/agent-flow/hook.js\"",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/yutaaoki/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/yutaaoki/.nvm/versions/node/v22.20.0/bin/node\" \"/Users/yutaaoki/.claude/agent-flow/hook.js\"",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/yutaaoki/.nvm/versions/node/v22.20.0/bin/node\" \"/Users/yutaaoki/.claude/agent-flow/hook.js\"",
            "timeout": 2
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/yutaaoki/.nvm/versions/node/v22.20.0/bin/node\" \"/Users/yutaaoki/.claude/agent-flow/hook.js\"",
            "timeout": 2
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/yutaaoki/.nvm/versions/node/v22.20.0/bin/node\" \"/Users/yutaaoki/.claude/agent-flow/hook.js\"",
            "timeout": 2
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "claude-mem@thedotmack": false,
    "figma@claude-plugins-official": false
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "xhigh"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-daltonized",
  "agentPushNotifEnabled": true
}
